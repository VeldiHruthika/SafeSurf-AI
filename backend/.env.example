# SafeSurf AI - backend configuration
#
# Copy this file to `.env` in the same folder and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real keys or passwords.


# ---------------------------------------------------------
# Gemini - AI Assistant, report analysis, symptom analysis
# ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# If this is blank the server still runs and falls back to the
# rule-based symptom matcher.

GEMINI_API_KEY=


# ---------------------------------------------------------
# Email - OTP delivery and contact form notifications
# ---------------------------------------------------------
# Gmail will NOT accept the account password. You need an App
# Password:
#
#   1. Google Account > Security
#   2. Turn on 2-Step Verification (App passwords are hidden
#      until this is enabled)
#   3. Security > App passwords > create one for "Mail"
#   4. Paste the 16 characters below with the spaces removed
#
# If these are blank the server still runs: OTPs are printed to
# the server console instead of emailed, which is fine for local
# development.

EMAIL_USER=
EMAIL_PASS=


# Where contact form messages are delivered.
# Defaults to EMAIL_USER when blank.

CONTACT_INBOX=

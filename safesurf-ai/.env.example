# SafeSurf AI - frontend configuration
#
# Copy to `.env` in this folder only if you need to change the default:
#     cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it reads this
# file at startup - restart `npm run dev` after changing it.


# Where the backend is running. Must match the backend's PORT.
# Defaults to http://localhost:5050 when unset.
#
# Note: do NOT use port 5000 on macOS. AirPlay Receiver listens there and
# answers without CORS headers, which the browser reports as a generic
# "Network error".

VITE_API_URL=http://localhost:5050
